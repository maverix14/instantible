#: pwa/admin/templates/subpage-offlineusage.php:62
#: pwa/admin/templates/subpage-offlineusage.php:74
#: pwa/admin/templates/subpage-offlineusage.php:86
#: pwa/admin/templates/subpage-offlineusage.php:98
#: pwa/admin/templates/subpage-offlineusage.php:110
#: pwa/admin/templates/subpage-offlineusage.php:122
#: pwa/admin/templates/subpage-offlineusage.php:134
msgid "Network Only"
msgstr ""

#: pwa/admin/templates/subpage-offlineusage.php:55
msgid "Select the caching strategy for your pages (HTML files). We recommend you to set it on Network First always show users latest version of your website and same time update the cache in the background in any case if the user is on slow connectivity or offline."
msgstr ""

#: pwa/admin/templates/subpage-offlineusage.php:56
